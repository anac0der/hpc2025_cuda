ARCH ?= sm_60
HOST_COMP ?= mpicc

# Compiler
NVCC := nvcc

# Compiler flags
NVCC_FLAGS = -O3 -std=c++11 -Xcompiler "-Wall -Wextra" -ccbin=$(HOST_COMP) -arch=$(ARCH)
MPI_INCLUDE = -I/opt/ibm/spectrum_mpi/include
MPI_LIB     = -L/opt/ibm/spectrum_mpi/lib -lmpiprofilesupport -lmpi_ibm

# Source files
SRC_CPP = v_mpi_cuda.cpp utils.cpp
SRC_CU  = kernel_01.cu

# Output executable
TARGET = run_mpi_cuda

# Build rule
all: $(TARGET)

$(TARGET):
	$(NVCC) $(NVCC_FLAGS) $(MPI_INCLUDE) $(SRC_CPP) $(SRC_CU) $(MPI_LIB) -lcudart -lstdc++ -o $(TARGET)

# Clean rule
clean:
	rm -f $(TARGET)
